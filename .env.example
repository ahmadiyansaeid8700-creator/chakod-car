# Server-only OpenAI credential. Never expose this value with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Shared server-to-server secret used by api.chakod.com when calling the AI route.
CHAKOD_AI_WEBHOOK_SECRET=

# High-volume default: strong quality with lower cost than the flagship model.
OPENAI_LISTING_REVIEW_MODEL=gpt-5.6-terra

# General user/admin copilot. Keep this server-only.
OPENAI_ASSISTANT_MODEL=gpt-5.6-sol

# Balanced reasoning for search, comparison and operational analysis.
# Allowed values: low, medium, high, xhigh, max
OPENAI_ASSISTANT_REASONING=medium

# Comma-separated HTTPS hosts from which listing images may be reviewed.
CHAKOD_AI_IMAGE_HOSTS=api.chakod.com,chakod.com,www.chakod.com

# Canonical backend endpoint that settles a Commerce order after a wallet debit.
# Keep empty until api.chakod.com exposes the corresponding idempotent server contract.
# Relative values are resolved by the existing Chakod auth/API proxy; an absolute HTTPS URL is also accepted.
CHAKOD_WALLET_SETTLEMENT_ENDPOINT=

# Action sent to the wallet settlement endpoint. The default in code is pay_order_with_wallet.
CHAKOD_WALLET_SETTLEMENT_ACTION=pay_order_with_wallet

# Optional server-to-server secret for the wallet settlement endpoint.
# Never expose this value with NEXT_PUBLIC_.
CHAKOD_WALLET_SETTLEMENT_SECRET=

# Canonical backend endpoint that performs a real gateway refund after admin approval.
# Keep empty until the payment backend exposes an idempotent refund contract.
# Relative values use the existing Chakod auth/API proxy; an absolute HTTPS URL is also accepted.
CHAKOD_REFUND_ENDPOINT=

# Action sent to the refund endpoint. The default in code is refund_payment.
CHAKOD_REFUND_ACTION=refund_payment

# Optional server-to-server secret for refund settlement.
# Sent only from the server as X-Chakod-Refund-Secret. Never expose with NEXT_PUBLIC_.
CHAKOD_REFUND_SECRET=

# Instagram story publishing. Keep disabled until the official Chakod Instagram
# professional account and a Meta app have been connected and tested.
INSTAGRAM_PUBLISH_ENABLED=false

# Set this explicitly when enabling publishing so a future Meta API upgrade is deliberate.
# Example only: vXX.X
INSTAGRAM_GRAPH_API_VERSION=

# Instagram professional/business account ID that receives Chakod stories.
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Long-lived server-side Meta access token. Never expose with NEXT_PUBLIC_.
INSTAGRAM_ACCESS_TOKEN=

# Random secret used by the VPS Cron/Worker when calling
# /api/internal/instagram-story-publisher.
INSTAGRAM_PUBLISHER_SECRET=

# Vehicles below this price are never admitted to the Instagram queue.
INSTAGRAM_STORY_MIN_PRICE_TOMAN=3000000000

# Maximum number of Instagram story publications per Tehran calendar day.
INSTAGRAM_STORY_DAILY_CAPACITY=20

# Minimum gap between two successful Instagram story publications.
INSTAGRAM_STORY_MIN_INTERVAL_MINUTES=30

# Failed Meta publications are retried up to this many times.
INSTAGRAM_STORY_MAX_ATTEMPTS=5

# Used by scripts/run-instagram-story-publisher.mjs on a VPS Cron job.
CHAKOD_BASE_URL=https://chakod.com

# Pre-launch visual QA fixtures. Keep both false in production and enable only
# on an isolated preview/staging deployment. They never write to the database.
NEXT_PUBLIC_PRELAUNCH_FIXTURES=false
PRELAUNCH_FIXTURES=false
