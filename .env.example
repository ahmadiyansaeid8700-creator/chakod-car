# Server-only OpenAI credential. Never expose this value with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Shared server-to-server secret used by api.chakod.com when calling listing moderation.
CHAKOD_AI_WEBHOOK_SECRET=

# Listing review model. Keep this server-only.
OPENAI_LISTING_REVIEW_MODEL=gpt-5.6-terra

# Comma-separated HTTPS hosts from which listing images may be reviewed.
CHAKOD_AI_IMAGE_HOSTS=api.chakod.com,chakod.com,www.chakod.com

# Chakod AI Manager is opt-in and disabled by default.
CHAKOD_AI_MANAGER_ENABLED=false

# Allowed values: disabled, openai, local
CHAKOD_AI_MANAGER_PROVIDER=disabled

# OpenAI model used only by Chakod AI Manager when provider=openai.
CHAKOD_AI_MANAGER_OPENAI_MODEL=gpt-5.4

# Provider timeout is clamped by the server to 1-30 seconds.
CHAKOD_AI_MANAGER_TIMEOUT_MS=12000

# Local provider is intentionally restricted to localhost/loopback endpoints.
CHAKOD_AI_LOCAL_ENDPOINT=
