# Server-only OpenAI credential. Never expose this value with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Shared server-to-server secret used by api.chakod.com when calling the AI route.
CHAKOD_AI_WEBHOOK_SECRET=

# High-volume default: strong quality with lower cost than the flagship model.
OPENAI_LISTING_REVIEW_MODEL=gpt-5.6-terra

# General user/admin copilot. Keep this server-only.
OPENAI_ASSISTANT_MODEL=gpt-5.6-sol

# Balanced reasoning for search, comparison and operational analysis.
# Allowed values: low, medium, high, xhigh, max
OPENAI_ASSISTANT_REASONING=medium

# Comma-separated HTTPS hosts from which listing images may be reviewed.
CHAKOD_AI_IMAGE_HOSTS=api.chakod.com,chakod.com,www.chakod.com

# Canonical backend endpoint that settles a Commerce order after a wallet debit.
# Keep empty until api.chakod.com exposes the corresponding idempotent server contract.
# Relative values use CHAKOD_API_ORIGIN; an absolute HTTPS URL is also accepted.
CHAKOD_WALLET_SETTLEMENT_ENDPOINT=

# Action sent to the wallet settlement endpoint. The default in code is pay_order_with_wallet.
CHAKOD_WALLET_SETTLEMENT_ACTION=pay_order_with_wallet

# Optional server-to-server secret for the wallet settlement endpoint.
# Never expose this value with NEXT_PUBLIC_.
CHAKOD_WALLET_SETTLEMENT_SECRET=
