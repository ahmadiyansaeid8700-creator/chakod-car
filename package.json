{
  "name": "chakod-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "vite --config vite.windows.config.ts",
    "dev:cloudflare": "vite",
    "build": "bash scripts/build-verified.sh",
    "build:preflight": "vite build --config vite.windows.config.ts",
    "start": "vinext start",
    "smoke:portable": "bash scripts/smoke-portable.sh",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:contracts": "node --experimental-strip-types --test tests/homepage-contract.test.mjs tests/dealer-directory-contract.test.mjs tests/ai-assistant-contract.test.mjs tests/finance-commerce-contract.test.mjs tests/featured-showroom-contract.test.mjs tests/migration-chain-contract.test.mjs tests/local-development-login.test.mjs tests/local-development-session.test.mjs tests/local-public-api.test.mjs tests/route-access.test.mjs",
    "check:launch": "npx tsc --noEmit -p tsconfig.launch.json && npm run test:contracts",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "چاکود"
}
